<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 10 o menor: permiso clásico de lectura de almacenamiento. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 11+: acceso a todos los archivos para poder leer el pendrive
         por ruta directa (/storage/XXXX-XXXX). App de uso personal, no
         orientada a Play Store. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Android 10+: "Mostrar sobre otras apps" es lo que permite que la app
         se abra sola (desde segundo plano) al conectar el pendrive. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Android 14+: keep awake. Si Power apaga la pantalla con la app en uso,
         la app la vuelve a encender ("Encender la pantalla"). -->
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:requestLegacyExternalStorage="true"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- Autoarranque SIN preguntar: al conectar un pendrive este receptor
           abre la app. (La actividad ya no declara USB_DEVICE_ATTACHED: eso es
           lo que hacía que Android preguntara "¿Abrir con…?"). -->
      <receiver
        android:name=".usb.UsbAutoOpenReceiver"
        android:exported="true">
        <intent-filter>
            <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
        </intent-filter>
      </receiver>

      <service
        android:name="com.doublesymmetry.trackplayer.service.MusicService"
        android:foregroundServiceType="mediaPlayback"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent-filter>
      </service>
    </application>
</manifest>
